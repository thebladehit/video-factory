{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "editor-demos",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "prototypes/editor-demos",
        "run",
        "dev"
      ],
      "port": 5199
    },
    {
      "name": "web-e2e-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@vf/web",
        "exec",
        "vite",
        "--port",
        "5174",
        "--strictPort"
      ],
      "env": {
        "VF_API_URL": "http://localhost:3101"
      },
      "port": 5174
    }
  ]
}
