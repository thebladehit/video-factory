# Postgres (docker compose)
DATABASE_URL=postgres://vf:vf@localhost:5433/vf
TEST_DATABASE_URL=postgres://vf:vf@localhost:5433/vf_test

# S3-сумісне сховище (RustFS у docker compose)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=vfadmin
S3_SECRET_ACCESS_KEY=vfadmin-secret
S3_BUCKET=vf-media
S3_FORCE_PATH_STYLE=true
# Адреса сховища для браузера (presigned URL). У Docker відрізняється від S3_ENDPOINT
S3_PUBLIC_ENDPOINT=http://localhost:9000

QUEUE_DRIVER=inprocess
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
# Порожньо = 127.0.0.1 (у контейнері docker compose задає 0.0.0.0)
API_HOST=
# Порожньо = ffmpeg / ffprobe з PATH (у контейнері api вони вже є)
FFMPEG_PATH=
FFPROBE_PATH=

# AI-провайдери (порожньо = провайдер недоступний)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# 1 = увімкнути fake-провайдер (розробка без ключів)
AI_FAKE=1

# Публікація в YouTube: OAuth-клієнт Google (тип «Web application»).
# Redirect URI у Google Cloud Console: ${WEB_ORIGIN}/oauth/youtube/callback (напр. http://localhost:5173/oauth/youtube/callback).
# Порожньо = кнопка «Підключити YouTube» вимкнена, публікація лише вручну.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Ключ шифрування токенів (32 байти, base64): openssl rand -base64 32. Обов'язковий, якщо задано YOUTUBE_CLIENT_ID
TOKEN_ENCRYPTION_KEY=
# 1 = застосунок пройшов аудит YouTube API (лише для підказки в UI)
YOUTUBE_API_AUDITED=0
# 1 = fake OAuth і публікатор замість YouTube (розробка без Google, e2e)
PUBLISH_FAKE=
